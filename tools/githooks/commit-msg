#!/bin/sh
# Refuse a commit message carrying a blocklisted term.
#
# Separate from pre-commit because a pre-commit hook never sees the message, and
# the message is where terms have actually landed: a commit that sanitizes a file
# tends to describe what it took out.
#
# Same contract as pre-commit, for the same reason: no `exit 0` here, so a guard
# this hook cannot import fails the commit instead of waving it through.
set -e

repo=$(git rev-parse --show-toplevel)
common=$(git rev-parse --git-common-dir)
primary=$(cd "$(dirname "$common")" && pwd)

# One level up from the checkout: on this family's Mac there is ONE venv beside
# the twelve repositories rather than one inside each, so none of the candidates
# above exists there and the search falls through to whatever `python3` is on
# PATH -- which cannot import the package unless that venv happens to be
# activated. Measured across the family: every hook failed on
# ModuleNotFoundError rather than on a blocked term, which is a checkout that
# has silently stopped being guarded.
family=$(dirname "$primary")

for candidate in \
    "$repo/.venv/Scripts/python.exe" \
    "$repo/.venv/bin/python" \
    "$primary/.venv/Scripts/python.exe" \
    "$primary/.venv/bin/python" \
    "$family/.venv/Scripts/python.exe" \
    "$family/.venv/bin/python"
do
    if [ -x "$candidate" ]; then python="$candidate"; break; fi
done
# An unresolved name is itself the loud failure: the exec below fails and the
# commit stops, rather than a branch here deciding to let it through.
python=${python:-$(command -v python3 || command -v python || echo python3)}

message=$1
cd "$repo"
exec "$python" -m app_support.sanitize --message "$message"
